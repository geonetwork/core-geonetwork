  <mdb:contentInfo>
    <mrc:MD_FeatureCatalogue>
      <mrc:featureCatalogue>
        <gfc:FC_FeatureCatalogue>
          <cat:name>
            <gco:CharacterString>Process parameters</gco:CharacterString>
          </cat:name>
          <cat:versionNumber>
            <gco:CharacterString>0.1.0</gco:CharacterString>
          </cat:versionNumber>
          <gfc:featureType>
            <gfc:FC_FeatureType>
              <gfc:typeName>outputs</gfc:typeName>
              <gfc:carrierOfCharacteristics>
                <gfc:FC_FeatureAttribute>
                  <gfc:memberName>Barplot image (DPI 300)</gfc:memberName>
                  <gfc:definition>
                    <gco:CharacterString>A high-resolution bar plot image (DPI = 300) where the Y-axis shows the test value and the X-axis shows the id and its groups. Opacity of bars is determined by the significance of the p-values based on the p_value_threshold.</gco:CharacterString>
                  </gfc:definition>
                  <gfc:cardinality>
                    <gco:CharacterString />
                  </gfc:cardinality>
                  <gfc:code>
                    <gco:CharacterString>barplot_image</gco:CharacterString>
                  </gfc:code>
                  <gfc:valueType>
                    <gco:TypeName>
                      <gco:aName>
                        <gco:CharacterString>object (application/html)</gco:CharacterString>
                      </gco:aName>
                    </gco:TypeName>
                  </gfc:valueType>
                </gfc:FC_FeatureAttribute>
              </gfc:carrierOfCharacteristics>
              <gfc:featureCatalogue />
            </gfc:FC_FeatureType>
          </gfc:featureType>
          <gfc:featureType>
            <gfc:FC_FeatureType>
              <gfc:typeName>inputs</gfc:typeName>
              <gfc:carrierOfCharacteristics>
                <gfc:FC_FeatureAttribute>
                  <gfc:memberName>Input table</gfc:memberName>
                  <gfc:definition>
                    <gco:CharacterString>URL to the input table containing statistical analysis results. The table must include columns for test values, p-values, and group identifiers.</gco:CharacterString>
                  </gfc:definition>
                  <gfc:cardinality>
                    <gco:CharacterString>1..1</gco:CharacterString>
                  </gfc:cardinality>
                  <gfc:code>
                    <gco:CharacterString>input_data</gco:CharacterString>
                  </gfc:code>
                  <gfc:valueType>
                    <gco:TypeName>
                      <gco:aName>
                        <gco:CharacterString>string</gco:CharacterString>
                      </gco:aName>
                    </gco:TypeName>
                  </gfc:valueType>
                </gfc:FC_FeatureAttribute>
              </gfc:carrierOfCharacteristics>
              <gfc:carrierOfCharacteristics>
                <gfc:FC_FeatureAttribute>
                  <gfc:memberName>Column name for p value</gfc:memberName>
                  <gfc:definition>
                    <gco:CharacterString>The name of the column containing p values, used to determine bar transparency. Example = "p_value"</gco:CharacterString>
                  </gfc:definition>
                  <gfc:cardinality>
                    <gco:CharacterString>1..1</gco:CharacterString>
                  </gfc:cardinality>
                  <gfc:code>
                    <gco:CharacterString>colname_p_value</gco:CharacterString>
                  </gfc:code>
                  <gfc:valueType>
                    <gco:TypeName>
                      <gco:aName>
                        <gco:CharacterString>string</gco:CharacterString>
                      </gco:aName>
                    </gco:TypeName>
                  </gfc:valueType>
                </gfc:FC_FeatureAttribute>
              </gfc:carrierOfCharacteristics>
              <gfc:carrierOfCharacteristics>
                <gfc:FC_FeatureAttribute>
                  <gfc:memberName>Column name for subgroups</gfc:memberName>
                  <gfc:definition>
                    <gco:CharacterString>The name of the column that defines the subgroups or categories to be displayed on the X-axis, e.g., seasons for every polygon_id.</gco:CharacterString>
                  </gfc:definition>
                  <gfc:cardinality>
                    <gco:CharacterString>1..1</gco:CharacterString>
                  </gfc:cardinality>
                  <gfc:code>
                    <gco:CharacterString>colname_group</gco:CharacterString>
                  </gfc:code>
                  <gfc:valueType>
                    <gco:TypeName>
                      <gco:aName>
                        <gco:CharacterString>string</gco:CharacterString>
                      </gco:aName>
                    </gco:TypeName>
                  </gfc:valueType>
                </gfc:FC_FeatureAttribute>
              </gfc:carrierOfCharacteristics>
              <gfc:carrierOfCharacteristics>
                <gfc:FC_FeatureAttribute>
                  <gfc:memberName>Column name for identifier</gfc:memberName>
                  <gfc:definition>
                    <gco:CharacterString>The name of the column containing group or sample identifiers, e.g., polygon id. Example = "polygon_id"</gco:CharacterString>
                  </gfc:definition>
                  <gfc:cardinality>
                    <gco:CharacterString>1..1</gco:CharacterString>
                  </gfc:cardinality>
                  <gfc:code>
                    <gco:CharacterString>colname_id</gco:CharacterString>
                  </gfc:code>
                  <gfc:valueType>
                    <gco:TypeName>
                      <gco:aName>
                        <gco:CharacterString>string</gco:CharacterString>
                      </gco:aName>
                    </gco:TypeName>
                  </gfc:valueType>
                </gfc:FC_FeatureAttribute>
              </gfc:carrierOfCharacteristics>
              <gfc:carrierOfCharacteristics>
                <gfc:FC_FeatureAttribute>
                  <gfc:memberName>Column name for test value</gfc:memberName>
                  <gfc:definition>
                    <gco:CharacterString>The name of the column containing the test values (e.g., statistical coefficients) to be plotted on the Y-axis, e.g., Tau for Mann-Kendall test.</gco:CharacterString>
                  </gfc:definition>
                  <gfc:cardinality>
                    <gco:CharacterString>1..1</gco:CharacterString>
                  </gfc:cardinality>
                  <gfc:code>
                    <gco:CharacterString>colname_test_value</gco:CharacterString>
                  </gfc:code>
                  <gfc:valueType>
                    <gco:TypeName>
                      <gco:aName>
                        <gco:CharacterString>string</gco:CharacterString>
                      </gco:aName>
                    </gco:TypeName>
                  </gfc:valueType>
                </gfc:FC_FeatureAttribute>
              </gfc:carrierOfCharacteristics>
              <gfc:carrierOfCharacteristics>
                <gfc:FC_FeatureAttribute>
                  <gfc:memberName>p value threshold for significance</gfc:memberName>
                  <gfc:definition>
                    <gco:CharacterString>The threshold for distinguishing significant from insignificant values. It adjusts the transparency of bars in the plot. Example = "0.05"</gco:CharacterString>
                  </gfc:definition>
                  <gfc:cardinality>
                    <gco:CharacterString>1..1</gco:CharacterString>
                  </gfc:cardinality>
                  <gfc:code>
                    <gco:CharacterString>p_value_threshold</gco:CharacterString>
                  </gfc:code>
                  <gfc:valueType>
                    <gco:TypeName>
                      <gco:aName>
                        <gco:CharacterString>number</gco:CharacterString>
                      </gco:aName>
                    </gco:TypeName>
                  </gfc:valueType>
                </gfc:FC_FeatureAttribute>
              </gfc:carrierOfCharacteristics>
              <gfc:featureCatalogue />
            </gfc:FC_FeatureType>
          </gfc:featureType>
        </gfc:FC_FeatureCatalogue>
      </mrc:featureCatalogue>
    </mrc:MD_FeatureCatalogue>
