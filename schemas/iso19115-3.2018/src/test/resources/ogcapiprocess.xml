      <mri:supplementalInformation>
        <gco:CharacterString># Example:

          ##
          inputs
          * input_data:
          https://testserver.de/download/trend_analysis_results.csv
          * colname_p_value:
          P_Value
          * colname_group:
          season
          * colname_id:
          polygon_id
          * colname_test_value:
          Tau_Value
          * p_value_threshold:
          0.05



          # Execution modes:

          *
          sync-execute
          *
          async-execute</gco:CharacterString>
      </mri:supplementalInformation>
